# EscapeTheUAB - cubo generado para estructura de escenario
mtllib acento.mtl
o acento
v -1 -1 -1
v 1 -1 -1
v 1 1 -1
v -1 1 -1
v -1 -1 1
v 1 -1 1
v 1 1 1
v -1 1 1
vn 0 0 -1
vn 0 0 1
vn 0 -1 0
vn 0 1 0
vn -1 0 0
vn 1 0 0
usemtl acento
f 4//1 3//1 2//1 1//1
f 5//2 6//2 7//2 8//2
f 1//3 2//3 6//3 5//3
f 3//4 4//4 8//4 7//4
f 4//5 1//5 5//5 8//5
f 2//6 3//6 7//6 6//6
