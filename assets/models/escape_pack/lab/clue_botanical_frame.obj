mtllib clue_botanical_frame.mtl
o ClueBotanicalFrame

# Placa de 2 cm: cara frontal en -Y y posterior en +Y.
v -0.6 -0.01 -0.45
v 0.6 -0.01 -0.45
v 0.6 -0.01 0.45
v -0.6 -0.01 0.45
v -0.6 0.01 -0.45
v 0.6 0.01 -0.45
v 0.6 0.01 0.45
v -0.6 0.01 0.45

# Se conservan exactamente las cuatro UV originales en ambas caras.
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Normales exteriores: frontal, posterior, izquierda, derecha, abajo, arriba.
vn 0 -1 0
vn 0 1 0
vn -1 0 0
vn 1 0 0
vn 0 0 -1
vn 0 0 1

usemtl BotanicalPlate

# Frontal (-Y), winding coherente con su normal.
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Posterior (+Y), conserva la orientación UV de la imagen original.
f 5/1/2 7/3/2 6/2/2
f 5/1/2 8/4/2 7/3/2

# Cantos cerrados con normales exteriores y UV tomadas del borde de la placa.
f 1/1/5 5/1/5 6/2/5
f 1/1/5 6/2/5 2/2/5
f 4/4/6 3/3/6 7/3/6
f 4/4/6 7/3/6 8/4/6
f 1/1/3 4/4/3 8/4/3
f 1/1/3 8/4/3 5/1/3
f 2/2/4 6/2/4 7/3/4
f 2/2/4 7/3/4 3/3/4
