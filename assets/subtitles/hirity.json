    { "id": "story.hello", "speaker": "Hirity", "audio": "assets/audio/hirity/story/holahirity.ogg", "text": "Hola, soy Hirity, tu asistente personal.", "language": "es", "priority": 30, "category": "dialogue", "verified": true },
    { "id": "story.hello_gl", "speaker": "Hirity", "audio": "assets/audio/hirity/story/holahiritygallego.ogg", "text": "Ola, carallo, son... digo, o asistente persoal. Carallo, que che pasa?", "language": "gl", "priority": 30, "category": "dialogue", "verified": false,
