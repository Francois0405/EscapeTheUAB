{
  "note": "Borradores obtenidos con Whisper (small) o descritos a partir del recurso. Nadie los ha comparado todavia con el audio: poner validated=true solo despues de escucharlo.",
  "lines": [
    { "id": "story.hello", "speaker": "Hirity", "audio": "assets/audio/hirity/story/holahirity.ogg", "text": "Hola, soy Hirity, tu asistente personal.", "language": "es", "priority": 30, "category": "dialogue", "validated": false },
    { "id": "story.hello_gl", "speaker": "Hirity", "audio": "assets/audio/hirity/story/holahiritygallego.ogg", "text": "Ola, carallo, son... digo, o asistente persoal. Carallo, que che pasa?", "language": "gl", "priority": 30, "category": "dialogue", "validated": false },
    { "id": "story.grab_me", "speaker": "Hirity", "audio": "assets/audio/hirity/story/agarrame.ogg", "text": "¿Sabías que si pulsas la tecla E puedes agarrarme? ¡Pruébalo!", "language": "es", "priority": 30, "category": "dialogue", "validated": false },
    { "id": "story.well_done", "speaker": "Hirity", "audio": "assets/audio/hirity/story/lohashechobien.ogg", "text": "¡Lo has hecho chupi fantástico!", "language": "es", "priority": 30, "category": "dialogue", "validated": false },
    { "id": "search.where", "speaker": "Voz", "audio": "assets/audio/hirity/searching/heydondeestashirity.ogg", "text": "Hey, ¿dónde estás?", "language": "es", "priority": 20, "category": "dialogue", "validated": false },
    { "id": "search.come", "speaker": "Voz", "audio": "assets/audio/hirity/searching/venaquihirity.ogg", "text": "Ven aquí.", "language": "es", "priority": 20, "category": "dialogue", "validated": false },
    { "id": "damage.short", "speaker": "Hirity", "audio": "assets/audio/hirity/damage/damagehirity.ogg", "text": "¡Oh!", "language": "es", "priority": 10, "category": "dialogue", "validated": false },
    { "id": "damage.long", "speaker": "Hirity", "audio": "assets/audio/hirity/damage/damegehiritylong.ogg", "text": "¡Au, au, au! ¡No me hagas eso! ¡Para!", "language": "es", "priority": 15, "category": "dialogue", "validated": false },
    { "id": "ambient.cough", "speaker": "", "audio": "assets/audio/hirity/ambient/cough.ogg", "text": "[Tos]", "language": "es", "priority": 5, "category": "caption", "validated": false },
    { "id": "ambient.steps", "speaker": "", "audio": "assets/audio/hirity/ambient/pasosfuertes.ogg", "text": "[Pasos fuertes]", "language": "es", "priority": 5, "category": "caption", "validated": false },
    { "id": "appear.voice", "speaker": "", "audio": "assets/audio/hirity/appear/anotopat.ogg", "text": "A no topar.", "language": "ca", "priority": 10, "category": "dialogue", "validated": false },
    { "id": "appear.giggle", "speaker": "", "audio": "assets/audio/hirity/appear/heehee.ogg", "text": "[Risita]", "language": "es", "priority": 5, "category": "caption", "validated": false },
    { "id": "appear.music", "speaker": "", "audio": "assets/audio/hirity/appear/rickroll.ogg", "text": "[Fragmento musical]", "language": "es", "priority": 5, "category": "caption", "validated": false }
  ]
}
