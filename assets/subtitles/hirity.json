      ] },
    { "id": "story.grab_me", "speaker": "Hirity", "audio": "assets/audio/hirity/story/agarrame.ogg", "text": "¿Sabías que si pulsas la tecla E puedes agarrarme? ¡Pruébalo!", "language": "es", "priority": 30, "category": "dialogue", "verified": true },
    { "id": "story.well_done", "speaker": "Hirity", "audio": "assets/audio/hirity/story/lohashechobien.ogg", "text": "¡Lo has hecho chupi fantástico!", "language": "es", "priority": 30, "category": "dialogue", "verified": true },
    { "id": "search.where", "speaker": "Voz", "audio": "assets/audio/hirity/searching/heydondeestashirity.ogg", "text": "Hey, ¿dónde estás?", "language": "es", "priority": 20, "category": "dialogue", "verified": true },
    { "id": "search.come", "speaker": "Voz", "audio": "assets/audio/hirity/searching/venaquihirity.ogg", "text": "Ven aquí.", "language": "es", "priority": 20, "category": "dialogue", "verified": true },
    { "id": "damage.short", "speaker": "Hirity", "audio": "assets/audio/hirity/damage/damagehirity.ogg", "text": "¡Au!", "language": "es", "priority": 10, "category": "dialogue", "verified": true },
    { "id": "damage.long", "speaker": "Hirity", "audio": "assets/audio/hirity/damage/damegehiritylong.ogg", "text": "¡Au, au, au! ¡No me hagas eso! ¡Para!", "language": "es", "priority": 15, "category": "dialogue", "verified": true },
